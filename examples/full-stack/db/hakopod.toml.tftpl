# Settings from the Hakopod PostgreSQL blueprint (non-root UID 70, PGDATA in a
# subdirectory of the volume), joined to the "data" segment only.
schema_version = 1
name = "db"

[networks.data]
internal = true
virtual_network = "${network}"
segment = "data"

[services.postgres]
image = "${image}"
port = 5432
size = "medium"
run_as_user = 70
run_as_group = 0
fs_group = 0
args = ["postgres", "-c", "shared_buffers=64MB", "-c", "max_connections=50"]
networks = ["data"]

[services.postgres.volume]
mount_path = "/var/lib/postgresql/data"
size_gib = ${volume_gib}

[services.postgres.env]
PGDATA = "/var/lib/postgresql/data/pgdata"
POSTGRES_DB = "${database}"
POSTGRES_USER = "${user}"

[services.postgres.secrets]
# Read only when the data directory is first initialised; see README "Rotation".
POSTGRES_PASSWORD = { ref = "${password_secret}" }

[services.postgres.network_access]
from = []
from_applications = ["api/api", "worker/worker", "scheduler/cleanup"]
